# Skopiuj ten plik jako .env i uzupelnij wartosciami.
# Plik .env NIE trafia do repozytorium (jest w .gitignore).

# Konto administratora Metabase - MUSI byc dokladnie takie samo, jakie zalozysz
# przy pierwszym uruchomieniu Metabase na http://localhost:3000.
# Bez tych dwoch zmiennych backend nie wystartuje.
METABASE_USER=
METABASE_PASSWORD=

# Adres, pod ktorym przegladarka uzytkownika widzi Metabase (do publicznych linkow).
METABASE_PUBLIC_URL=http://localhost:3000
